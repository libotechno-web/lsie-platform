# إعدادات البيئة للمنصة الوطنية الليبية للابتكار وريادة الأعمال
# Environment Configuration for LSIE Platform

# المفتاح السري للتطبيق (يجب تغييره في بيئة الإنتاج إلى قيمة قوية وعشوائية)
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# إعدادات قاعدة البيانات:
# الافتراضي: SQLite (محفوظة في data/lsie.db)
# للانتقال إلى PostgreSQL قم بتعيين الرابط التالي:
# DATABASE_URL=postgresql://lsie_user:secure_password@localhost:5432/lsie_db
DATABASE_URL=sqlite:///data/lsie.db

# نمط التشغيل: development / production / testing
FLASK_ENV=development
FLASK_DEBUG=1

# الحد الأقصى لحجم الملفات المرفوعة بالبايت (16 ميجابايت)
MAX_CONTENT_LENGTH=16777216
